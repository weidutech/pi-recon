BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=

# Use a key SEPARATE from the main scoring agent when you can
PI_RECON_LLM_KEY=
PI_RECON_LLM_BASE=https://api.deepseek.com/v1
PI_RECON_LLM_PROVIDER=deepseek
PI_RECON_LLM_MODEL=deepseek-v4-flash
PI_RECON_LLM_ROUTE=public

# --- OrcaRouter Cyber Inference (named provider) -----------------------------
# Set PI_RECON_LLM_PROVIDER=orcarouter and drop PI_RECON_LLM_BASE/PI_RECON_LLM_MODEL:
# the provider preset uses https://api.orcarouter.ai/v1 and the live /v1/models catalog.
# Two ways to connect, both ending in a normal user-owned sk-orca-… relay key:
#   1) API key : PI_RECON_LLM_KEY=sk-orca-…   (create at https://www.orcarouter.ai/console/keys)
#   2) Login   : PI_RECON_ORCA_AUTH=pkce      (Connect with OrcaRouter, OAuth 2.0 + PKCE, no client secret)
# PKCE delivery: PI_RECON_ORCA_SCOPE=auto|loopback|oob (oob = paste the code shown on the consent page)
# PI_RECON_ORCA_AUTH=api_key
# PI_RECON_ORCA_SCOPE=auto
# Stop the run when OrcaRouter answers 401 (key revoked -> reconnect):
# PI_RECON_ORCA_KEEP=1
# Self-hosted / proxy overrides (explicit wins over the shared base):
# ORCA_AUTH_BASE_URL=https://www.orcarouter.ai
# ORCA_API_BASE_URL=https://api.orcarouter.ai
# ORCA_BASE_URL=

PI_RECON_CONCURRENCY=3
# platform max active instances is typically 3; higher values only burn start 409s
PI_RECON_JOB_TIMEOUT_SEC=1200
PI_RECON_JOBS_DIR=jobs
